# URL do Backend para o Frontend acessar
# Substitua com a URL pública do seu servidor
# Exemplo: http://seu-servidor.com:8000 ou https://api.seu-servidor.com
VITE_API_BASE_URL=http://localhost:8000

# Origens permitidas para CORS (separadas por vírgula)
# Substitua com os domínios que podem acessar o backend
# Exemplo: https://seu-servidor.com,https://www.seu-servidor.com
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173
